{
  "name": "eslint-plugin-prettier-doc",
  "version": "2.0.0",
  "description": "ESLint rules for Prettier Doc.",
  "homepage": "https://github.com/fisker/eslint-plugin-prettier-doc#readme",
  "bugs": {
    "url": "https://github.com/fisker/eslint-plugin-prettier-doc/issues"
  },
  "repository": "fisker/eslint-plugin-prettier-doc",
  "funding": "https://github.com/fisker/eslint-plugin-prettier-doc?sponsor=1",
  "license": "MIT",
  "author": {
    "name": "fisker Cheung",
    "email": "lionkay@gmail.com",
    "url": "https://www.fiskercheung.com/"
  },
  "sideEffects": false,
  "type": "module",
  "exports": "./index.js",
  "files": [
    "index.js",
    "rules/"
  ],
  "scripts": {
    "clean": "run-p \"clean:*\"",
    "clean:dist": "del-cli dist",
    "dist": "run-p \"dist:*\"",
    "dist:npm": "release-it",
    "fix": "run-p --continue-on-error \"fix:*\"",
    "fix:eslint": "yarn lint:eslint --fix",
    "fix:markdown": "yarn lint:markdown --fix",
    "fix:package-json": "sort-package-json \"package.json\" \"packages/*/package.json\"",
    "fix:prettier": "prettier . --write",
    "lint": "run-p --continue-on-error \"lint:*\"",
    "lint:eslint": "eslint .",
    "lint:markdown": "markdownlint-cli2",
    "lint:package-json": "yarn run fix:package-json --check",
    "lint:prettier": "prettier . --check",
    "release": "run-s lint test dist",
    "test": "node test.js",
    "test-coverage": "c8 --reporter=text --reporter=lcov yarn test"
  },
  "devDependencies": {
    "@fisker/eslint-config": "16.1.1",
    "@fisker/lint-staged-config": "4.0.1",
    "@fisker/markdownlint-cli2-config": "0.1.0",
    "@fisker/prettier-config": "6.0.1",
    "@fisker/release-it-config": "6.0.2",
    "c8": "12.0.0",
    "del-cli": "8.0.1",
    "eslint": "10.13.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "npm-run-all2": "9.0.3",
    "outdent": "0.8.0",
    "prettier": "3.9.10",
    "release-it": "21.1.1",
    "sort-package-json": "4.1.0"
  },
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
